{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__*",
      "mcp__figma-mcp-go__*",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npx next:*)",
      "Bash(npx playwright:*)",
      "Bash(git:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(gh auth *)",
      "Bash(python3 -m json.tool)",
      "Bash(python3 -m pip list)",
      "Bash(apt-get list:*)",
      "Bash(apt-get install:*)",
      "Bash(dpkg -l)",
      "Bash(chromium --version)",
      "Bash(/snap/bin/chromium --version)",
      "Bash(ls /usr/bin/chromium*)",
      "Bash(pkill -f \"uvicorn main:app\")",
      "Bash(pkill -f \"next dev\")",
      "Bash(pkill -f \"next-server\")",
      "Bash(fuser -k 3000/tcp)",
      "Bash(fuser -k 8000/tcp)",
      "Bash(curl -s http://localhost:3000)",
      "Bash(curl -s http://localhost:8000)",
      "Bash(curl -s http://localhost:8000/)",
      "Bash(curl -s http://localhost:8000/docs)",
      "Bash(curl -sv http://localhost:8000/)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8000/)",
      "Bash(curl -sI http://localhost:3000/ --max-time 5)",
      "Bash(curl -sI http://localhost:3001/ --max-time 5)",
      "Read(//usr/bin/**)",
      "Read(//usr/lib/**)",
      "Read(//opt/google/**)",
      "Read(//tmp/**)",
      "mcp__github__create_issue",
      "mcp__postgres__query",
      "mcp__puppeteer__puppeteer_navigate",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__plugin_figma_figma__whoami",
      "mcp__plugin_figma_figma__create_new_file",
      "mcp__plugin_figma_figma__use_figma",
      "mcp__plugin_figma_figma__search_design_system",
      "mcp__plugin_figma_figma__get_screenshot",
      "mcp__plugin_figma_figma__get_metadata",
      "mcp__figma__get_figma_data",
      "mcp__figma-mcp-go__get_document",
      "mcp__figma-mcp-go__get_metadata",
      "mcp__figma-mcp-go__get_pages",
      "mcp__figma-mcp-go__get_node",
      "mcp__figma-mcp-go__get_screenshot",
      "mcp__figma-mcp-go__search_nodes",
      "mcp__figma-mcp-go__create_frame",
      "mcp__figma-mcp-go__create_rectangle",
      "mcp__figma-mcp-go__create_text",
      "mcp__figma-mcp-go__set_corner_radius",
      "mcp__figma-mcp-go__set_strokes",
      "mcp__figma-mcp-go__set_fills",
      "mcp__figma-mcp-go__set_effects",
      "mcp__figma-mcp-go__move_nodes",
      "mcp__figma-mcp-go__add_page",
      "mcp__figma-mcp-go__rename_page",
      "mcp__figma-mcp-go__create_effect_style",
      "mcp__figma-mcp-go__apply_style_to_node"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "figma-mcp-go"
  ],
  "teammateMode": "tmux"
}
